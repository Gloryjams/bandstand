# Bandstand configuration
#
# Copy this file to ".env" and change what you need. Every line is optional for
# a first band: a server with no configuration at all starts and works.
#
# Docker Compose reads ".env" from the folder that holds docker-compose.yml.
# Without Docker, export the variables in the shell (or service manager) that
# starts the server.
#
# One server is one band. To run a second band, run a second server with its
# own data folder and its own port. Never point two servers at one data folder:
# the second one refuses to start.
#
# A value with a space or a special character (# $ ") goes in single quotes:
#   BANDSTAND_NAME='The #1 Band'
# A value with an apostrophe goes in double quotes:
#   BANDSTAND_NAME="Rea's Trio"
# A blank value means "not set", with one exception: BANDSTAND_DATA_DIR.

# ---------------------------------------------------------------------------
# The basics
# ---------------------------------------------------------------------------

# Name shown in the app header and in the band switcher.
BANDSTAND_NAME='Bandstand'

# Port the server listens on.
# With Docker Compose this is also the port published on the host.
BANDSTAND_PORT=7800

# Docker Compose only. The name that ties this band to its data. It must not
# change once the band has data, and every band on one computer needs its own.
# Small letters, numbers and dashes. Renaming or moving the FOLDER is fine.
#BANDSTAND_PROJECT=bandstand

# Where the library, the database and the director key live.
# Default without Docker: a "Bandstand" folder in your home directory. If that
# folder already belongs to a running server, set this to another folder.
# Inside the container this is always /data (the volume). Leave it alone there.
# Set but blank is refused: the server will not guess where your data goes.
#BANDSTAND_DATA_DIR=/home/you/Bandstand

# Address the server binds to when started with "python -m server.serve".
# 127.0.0.1 = this computer only. 0.0.0.0 = every device on your network.
# The container sets 0.0.0.0 for you, because the port mapping is the gate there.
#BANDSTAND_HOST=127.0.0.1

# Docker Compose only. The address on THIS computer that the port is published
# on. 0.0.0.0 = every device on your network can reach the server. Set it to
# 127.0.0.1 when a reverse proxy on the same computer is the only visitor.
#BANDSTAND_BIND=0.0.0.0

# Docker Compose only. The tag of ghcr.io/gloryjams/bandstand to run.
# Use a release number without the leading v to stay on that version.
# Change it when you update, then run "docker compose pull bandstand" and
# "docker compose up -d". The tag latest follows the newest release and is
# pulled on each "docker compose up" too.
BANDSTAND_VERSION=0.1.0

# Docker Compose only. Override the full image name and tag. When set, this
# takes the place of BANDSTAND_VERSION. See RELEASING.md.
#BANDSTAND_IMAGE=ghcr.io/gloryjams/bandstand:0.1.0
# For a numbered tag, Compose uses a cached image or tries to pull it, then
# builds from this folder if the image is missing. "docker compose up -d --build"
# forces a source build, even with an image set. For your own build you can use
# bandstand:source here.

# ---------------------------------------------------------------------------
# Limits (raise or lower to taste)
# ---------------------------------------------------------------------------

# Largest single upload, in megabytes.
BANDSTAND_MAX_UPLOAD_MB=50

# Ceiling for the whole library, in megabytes. 0 means no limit.
# Set a real number if the server is reachable from the internet.
BANDSTAND_LIBRARY_QUOTA_MB=0

# Docker Compose only. The most memory the server may use (and the share
# pages, if you run them). A ceiling, not a reservation.
#BANDSTAND_MEMORY=1g
#BANDSTAND_SHARE_MEMORY=512m

# ---------------------------------------------------------------------------
# Rehearsal rooms (off unless you switch them on)
# ---------------------------------------------------------------------------
# A rehearsal room is a QR code the band scans to post songs and vote from their
# phones. Anyone who can see that QR code can join, so rooms are OFF on a new
# install. Set this to 1 to switch them on. Existing installs that had rooms
# before this setting existed must set it to 1 to keep them.
# See docs/SELF-HOSTING.md, "Rehearsal rooms".
BANDSTAND_ROOMS=0

# How many rooms may be open at the same time. The app shows one room at a
# time, so 1 is the number for nearly everyone. Must be 1 or more.
BANDSTAND_ROOMS_MAX_OPEN=1

# How many songs one guest may post per minute. 0 means no limit.
BANDSTAND_ROOMS_PROPOSALS_PER_MINUTE=5

# How many guests one room takes. Must be 1 or more.
BANDSTAND_ROOMS_MAX_GUESTS=60

# ---------------------------------------------------------------------------
# Share links (optional)
# ---------------------------------------------------------------------------
# Share links are read-only pages for people who are not in the band. They are
# served by a second, separate process, so that strangers never touch the main
# app, and that process cannot read the director key.
# See docs/SELF-HOSTING.md, "Share links".
#
# With Docker Compose, all of these are needed to switch share pages on:
#COMPOSE_PROFILES=share
#BANDSTAND_SHARE_PAGES=1
#BANDSTAND_PUBLIC_BASE=https://share.example.com

# The address guests will reach the share pages on. It is printed into every
# share link and QR code, so it must be an address a guest's phone can open.
# Without it the app does not make share links at all, and says why.
#BANDSTAND_PUBLIC_BASE=https://share.example.com

# Lets the share pages run as a separate user that cannot read the key. The
# main server then allows its group to READ the library. Leave it off when you
# do not run share pages.
#BANDSTAND_SHARE_PAGES=1

# Docker Compose only. Where the share pages are published on this computer.
# 127.0.0.1 because a reverse proxy or a tunnel is what guests really reach.
#BANDSTAND_SHARE_BIND=127.0.0.1
#BANDSTAND_SHARE_PORT=7810

# The credit line at the bottom of every share page.
#BANDSTAND_SHARE_ATTRIBUTION='Shared from a gig book'

# Set to 1 ONLY when the share pages sit behind a Cloudflare tunnel. It makes
# the rate limiter trust the CF-Connecting-IP header. Anywhere else, leave it
# unset: the header can be forged by anyone who can reach the server directly.
#BANDSTAND_BEHIND_CF=1

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Request logging is OFF by default, on purpose. With the old-style live
# update address switched on (below), the key travels in the address and a
# request log would write keys to disk. Turn it on only for short debugging
# sessions, and treat the log as a secret while it is on.
# The share pages never log requests, whatever this says.
#BANDSTAND_ACCESS_LOG=0

# The live update stream (the part that makes a chart appear on every device
# the moment it is added) used to put the key in its address, where any proxy
# or log could record it. It now uses a ticket that lasts one minute and opens
# one stream. The old address still works for one release, for tablets that
# have not loaded the new app yet:
#   1 = the old address works too      0 = ticket only
# Unset, a server with data from before this version keeps the old address
# working and a new install refuses it. Only 1 or 0 is understood; anything else
# stops the server at start-up. This setting is removed in the next release,
# after which only the ticket opens the stream.
#BANDSTAND_EVENTS_KEY_IN_URL=0

# How much the server says: critical, error, warning, info or debug.
# Anything else is treated as info.
#BANDSTAND_LOG_LEVEL=info
